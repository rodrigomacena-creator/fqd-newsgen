// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id                  String   @id @default(cuid())
  sources             String // JSON string: { type: "youtube"|"webpage"; url: string; title: string; content: string; videoId?: string }[]
  title               String
  subtitle            String
  coverImage          String?
  sections            String // JSON string: { heading: string; text: string; image?: string }[]
  status              String   @default("done") // pending | done | failed
  textModel           String
  imageModel          String // usado pra capa e imagens de seção (Portal) — sempre fotografia, sem texto
  instagramImageModel String? // modelo usado pras imagens do Instagram (card com texto); null = notícia anterior a esse campo, usou imageModel
  profileId           String? // id do perfil usado (para releituras futuras, ex.: revisão); pode não existir mais
  profileName         String? // nome do perfil de instrução usado (snapshot; null = padrão neutro)
  subtitleCount       Int? // parâmetros de entrada escolhidos na geração; null = notícia anterior a esse campo
  paragraphCount      Int?
  photoCount          Int?
  extraInstructions   String?
  instagramCaption    String?
  instagramImage      String? // DEPRECATED: só lido pra notícias antigas (1 imagem só); gerações novas usam instagramImages
  instagramImages     String? // JSON string: string[] de URLs — carrossel do Instagram (1 ou mais)
  instagramPhotoCount Int? // quantidade de fotos pedida pro carrossel; null = notícia anterior a esse campo
  wordpressPostId     Int? // id do post criado no WordPress (fqdtv.site), se já foi enviado
  wordpressUrl        String? // link de edição do post no wp-admin
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Settings {
  id                         String   @id @default("default")
  defaultTextModel           String
  defaultImageModel          String
  defaultInstagramImageModel String   @default("krea/krea-2-medium-turbo")
  updatedAt                  DateTime @updatedAt
}

model InstructionProfile {
  id                 String   @id @default(cuid())
  name               String
  prompt             String
  styleguideFileName String? // nome original do arquivo enviado pelo usuário
  styleguidePath     String? // caminho público do arquivo salvo (/styleguides/{id}/...)
  styleguideColors   String? // JSON: string[] de cores hex extraídas do arquivo
  styleguideSummary  String? // texto/contexto extraído do arquivo (ex.: trecho de PDF)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// VideoGen: um vídeo curto (Reels/Shorts) gerado a partir de um padrão do catálogo
// (videogen/padroes). O app gera roteiro e narração; a renderização do mp4 é feita
// por um worker fora da Vercel (VPS), que pega jobs com status "queued".
model VideoJob {
  id                 String    @id @default(cuid())
  topic              String
  patternId          String // id do padrão em videogen/padroes (ex.: "editorial-pb-vermelho")
  voiceId            String // voice_id do ElevenLabs
  voiceName          String
  durationS          Int // duração alvo em segundos
  textModel          String // modelo da OpenRouter usado no roteiro
  extraInstructions  String?
  articleId          String? // notícia do NewsGen que serviu de base (sem FK: notícia apagada = vídeo segue)
  styleNotes         String? // direcionamento do usuário para o "estilo livre" (movimento, música, clima...)
  status             String    @default("draft") // draft | script_ready | queued | rendering | done | failed
  script             String? // JSON string: VideoScript (ver src/lib/videogen/types.ts)
  narrationUrl       String? // mp3 da narração no Vercel Blob
  narrationWords     String? // JSON string: [palavra, início_s, fim_s][] (palavras já com a grafia de exibição)
  narrationDurationS Float?
  videoUrl           String? // mp4 final no Vercel Blob (escrito pelo worker)
  previewUrl         String? // prévia rápida (baixa fluidez, sem trilha) no Vercel Blob
  coverUrl           String? // capa 9:16 (Reels/Shorts) gerada no render final
  thumbUrl           String? // thumbnail 16:9 (YouTube) gerada no render final
  renderMode         String? // "preview" enquanto a prévia está na fila/renderizando; null = render final
  format             String   @default("9:16") // "9:16" (Reels/Shorts, padrão) ou "16:9" (YouTube horizontal)
  progress           Int? // 0-100, atualizado pelo worker
  costs              String? // JSON string: CostEntry[] (gastos de OpenRouter e ElevenLabs, ver src/lib/videogen/costs.ts)
  personId           String? // VideoProfile (kind person) que fala no vídeo; sem FK de propósito (perfil apagado = genérico)
  companyId          String? // VideoProfile (kind company) para quem é o conteúdo
  briefingImages     String? // JSON string: BriefingImage[] (imagens enviadas pelo usuário, usadas nas cenas sem gerar)
  avatar             String? // JSON string: AvatarTrack (vídeo base: avatar do Higgsfield ou vídeo do usuário; ver src/lib/videogen/avatar.ts)
  speaker            String    @default("ai_voice") // quem fala: "ai_voice" (voz do ElevenLabs) | "ai_avatar" (voz + avatar do Higgsfield) | "upload" (áudio/vídeo enviado)
  avatarImageUrl     String? // foto escolhida na criação para o avatar (Blob); sem ela usa a do perfil de quem fala
  error              String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
}

// Estilo de vídeo montado pela aplicação a partir de um vídeo de referência (/videogen/templates).
// O worker analisa o vídeo com IA, preenche a ficha de estilo (spec) que o motor genérico
// (worker/render/template_engine.py) sabe renderizar e gera um exemplo de 5s.
model VideoTemplate {
  id           String    @id @default(cuid())
  name         String
  referenceUrl String // vídeo de referência enviado pelo usuário (Vercel Blob) ou o próprio link (quando sourceUrl)
  sourceUrl    String? // link do YouTube/Pinterest; o worker baixa o vídeo com yt-dlp
  notes        String? // observações do usuário sobre o que aproveitar do vídeo
  status       String    @default("queued") // queued | analyzing | ready | failed
  progress     Int?
  spec         String? // JSON: ficha de estilo (ver worker/render/template_engine.py)
  summary      String? // JSON: { tom, ritmo, cenaS, semNarracao, cta } pro seletor e pro roteiro
  guide        String? // markdown com as dicas do estilo, entra no prompt do roteiro
  sampleUrl    String? // exemplo de 5s renderizado pelo motor genérico
  costs        String? // JSON: CostEntry[]
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

// Perfis de comunicação do VideoGen: quem fala no vídeo (pessoa) e para quem é o conteúdo (empresa).
// Entram no prompt do roteiro, na voz da narração e nas pronúncias.
model VideoProfile {
  id             String   @id @default(cuid())
  kind           String // person | company
  name           String
  description    String? // quem é / sobre a empresa
  tone           String? // tom de voz, humor
  speech         String? // jeito de falar: vocabulário, bordões, o que evitar
  voiceId        String? // pessoa: voz do ElevenLabs
  voiceName      String?
  site           String? // empresa
  instagram      String? // @perfil (sem inventar quando vazio)
  cta            String? // CTA padrão
  logoUrl        String? // empresa: logo no Vercel Blob
  avatarUrl      String? // pessoa: foto do avatar (Higgsfield) no Vercel Blob
  colors         String? // empresa: cores da marca (texto livre, ex.: "#E10600, preto")
  pronunciations String? // JSON: Pronunciation[] (ex.: nome da marca falado)
  isDefault      Boolean  @default(false)
  neutral        Boolean  @default(false) // conteúdo neutro/informativo: nada de marca, venda ou CTA comercial
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([kind, name])
}

// Contas de rede social conectadas para publicar os vídeos do VideoGen (uma por plataforma).
// Tokens de OAuth: refresh token do Google (YouTube) e token de longa duração do Instagram.
model SocialAccount {
  platform     String    @id // youtube | instagram
  accountId    String // id do canal / id do usuário do Instagram
  accountName  String // nome do canal / @usuario
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Publicação de um vídeo numa rede (agora ou agendada). O YouTube agenda nativamente (publishAt);
// o Instagram é publicado quando a hora chega (o worker chama /api/videogen/worker/publish-tick).
model VideoPublication {
  id          String    @id @default(cuid())
  jobId       String
  platform    String // youtube | instagram
  status      String // pending | processing | published | scheduled | failed
  title       String?
  caption     String?
  privacy     String? // youtube: public | unlisted | private
  scheduledAt DateTime?
  containerId String? // instagram: contêiner de mídia em processamento
  externalId  String? // id do vídeo/mídia publicada
  url         String?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobId])
  @@index([status, scheduledAt])
}
