# URL do NewsGen (produção) e o mesmo token configurado na Vercel como VIDEOGEN_WORKER_TOKEN
VIDEOGEN_APP_URL="https://SEU-APP.vercel.app"
VIDEOGEN_WORKER_TOKEN=""

# Chaves usadas pelo worker para gerar as imagens das cenas e a trilha
OPENROUTER_API_KEY=""
ELEVENLABS_API_KEY=""

# Opcionais
# VIDEOGEN_IMAGE_MODEL="google/gemini-nano-banana-2.1"
# Modelo com visão que analisa o vídeo de referência ao montar um template
# VIDEOGEN_VISION_MODEL="anthropic/claude-sonnet-5.5"
# VIDEOGEN_POLL_SECONDS="10"
# VIDEOGEN_MUSIC_CREDITS_PER_SECOND="13.75"   # estimativa do custo da trilha no ElevenLabs
# VIDEOGEN_WORKDIR="/var/lib/videogen-worker"
# VIDEOGEN_FONT_SANS="/usr/share/fonts/opentype/inter/InterDisplay-Black.otf"
# VIDEOGEN_FONT_SERIF="/usr/share/fonts/truetype/liberation/LiberationSerif-BoldItalic.ttf"
