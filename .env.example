# Banco de dados Postgres (ex.: Prisma Postgres — console.prisma.io)
DATABASE_URL=""

# Token de leitura/escrita do Vercel Blob (Storage > Blob no dashboard da Vercel,
# ou `vercel blob create-store` via CLI) — usado pra armazenar as imagens geradas
BLOB_READ_WRITE_TOKEN=""

# Chave da OpenRouter (https://openrouter.ai/keys) — obrigatória
OPENROUTER_API_KEY=""

# Modelos usados por padrão (opcional — já vem com um padrão econômico se omitido)
# OPENROUTER_TEXT_MODEL="google/gemini-2.5-flash-lite"
# OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image"
