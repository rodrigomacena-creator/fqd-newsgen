# Banco de dados Postgres (ex.: Prisma Postgres — console.prisma.io)
DATABASE_URL=""

# Token de leitura/escrita do Vercel Blob (Storage > Blob no dashboard da Vercel,
# ou `vercel blob create-store` via CLI) — usado pra armazenar as imagens geradas
BLOB_READ_WRITE_TOKEN=""

# Chave da OpenRouter (https://openrouter.ai/keys) — obrigatória
OPENROUTER_API_KEY=""

# Modelos usados por padrão (opcional — já vem com um padrão econômico se omitido)
# OPENROUTER_TEXT_MODEL="google/gemini-2.5-flash-lite"
# OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image"

# Proxy residencial rotativo (opcional, mas necessário em produção na Vercel — o
# YouTube bloqueia extração de transcrição de IPs de datacenter). Ex.: Webshare
# "Residential" (não confundir com "Proxy List", que é datacenter), endpoint
# "Backbone Connection". Se omitido, usa fetch direto (funciona em dev local).
RESIDENTIAL_PROXY_HOST=""
RESIDENTIAL_PROXY_PORT=""
RESIDENTIAL_PROXY_USER=""
RESIDENTIAL_PROXY_PASSWORD=""

# Integração com o Portal WordPress — usa Senha de Aplicativo (Usuários > Perfil >
# Senhas de Aplicativo no wp-admin), nunca a senha de login normal
WORDPRESS_URL=""
WORDPRESS_USERNAME=""
WORDPRESS_APP_PASSWORD=""

# Chave da YouTube Data API v3 (console.cloud.google.com > APIs e serviços > Credenciais) —
# usada só pra listar os vídeos de um canal (campo "Vídeos de um canal" na home)
YOUTUBE_API_KEY=""

# VideoGen (/videogen): narração com timestamps e lista de vozes no ElevenLabs
ELEVENLABS_API_KEY=""
# Modelo do roteiro dos vídeos (opcional; padrão: Claude via OpenRouter)
# VIDEOGEN_TEXT_MODEL="anthropic/claude-sonnet-5.5"
